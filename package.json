{
    "name": "diff-viewer",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "pack": "vite build && electron-builder --dir",
        "test:unit": "vitest",
        "type-check": "vue-tsc --build",
        "lint": "oxlint . --fix",
        "format": "oxfmt"
    },
    "dependencies": {
        "@lucide/vue": "^1.34.0",
        "@tailwindcss/vite": "^4.3.3",
        "chokidar": "^5.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "electron-store": "^11.0.2",
        "monaco-editor": "^0.53.0",
        "pinia": "^4.0.3",
        "simple-git": "^3.36.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.41",
        "vue-virtual-scroller": "^3.0.5"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.3.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3",
        "jiti": "^2.7.0",
        "jsdom": "^30.0.1",
        "npm-run-all2": "^9.0.3",
        "oxfmt": "^0.65.0",
        "oxlint": "~1.80.0",
        "sass-embedded": "^1.103.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vite-plugin-electron": "^1.1.1",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "electron-winstaller@5.4.0": true
    },
    "build": {
        "appId": "com.yannieck.diff-viewer",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**",
            "dist-electron/**"
        ]
    }
}
