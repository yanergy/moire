{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "es5",
    "sortPackageJson": false,
    "ignorePatterns": ["dist/**", "dist-electron/**", "release/**", "coverage/**", "**/*.md"]
}
