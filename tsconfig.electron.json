{
    "extends": "@tsconfig/node24/tsconfig.json",
    "include": ["electron/**/*.ts"],
    "compilerOptions": {
        // The main process is bundled by vite-plugin-electron (rollup), so the
        // source is authored as ESM TypeScript and resolved the way the bundler
        // resolves; the emitted dist-electron output stays CommonJS.
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "noEmit": true,
        "types": ["node"],
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tsbuildinfo"
    }
}
